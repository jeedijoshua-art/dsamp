# ==============================================================================
# FraudGraph - Environment Configuration Example
# ==============================================================================
# Copy this file to .env in backend/ or root if overriding defaults.
# Defaults are already configured for immediate local operation out of the box.

# Backend HTTP API port (Default: 5001)
PORT=5001

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Frontend Dev Server Port (Default: 5173)
VITE_PORT=5173

# Frontend API Target Proxy (Default: http://localhost:5001)
VITE_API_URL=http://localhost:5001
